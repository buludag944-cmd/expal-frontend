{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor-firebase/messaging": "^8.2.0",
    "@capacitor-firebase/authentication": "^8.2.0",
    "firebase": "^12.6.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.2",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node scripts/ensure-logo.js",
    "build": "react-scripts build",
    "build:netlify": "bash scripts/build-netlify.sh",
    "netlify:zip": "bash scripts/package-netlify-zip.sh",
    "firebase:deploy": "npm run build:netlify && firebase deploy --only hosting",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cap:sync": "bash scripts/cap-sync.sh",
    "cap:deploy": "bash scripts/cap-sync.sh && npx cap copy",
    "cap:copy": "npx cap copy",
    "cap:ios": "npx cap open ios",
    "ios:sync": "bash scripts/build-ios-sync.sh",
    "ios:verify-firebase": "node scripts/verify-google-services-ios.js",
    "ios:github-secrets": "echo 'See IOS_GITHUB_CI.md for required GitHub Actions secrets'",
    "cap:android": "npx cap open android",
    "android:build": "cd android && JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" ./gradlew assembleDebug",
    "android:sha1": "keytool -list -v -alias androiddebugkey -keystore \"$HOME/.android/debug.keystore\" -storepass android | grep -E 'SHA1:|SHA256:'",
    "cap:assets": "npx @capacitor/assets generate --ios --android",
    "logo:apply": "node scripts/apply-logo.js",
    "android:release": "cd android && ./gradlew bundleRelease",
    "android:bundle": "bash scripts/build-android-bundle.sh",
    "store:prep": "npm run build:netlify && npm run logo:apply -- --cap && npx cap sync android"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}
